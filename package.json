{
  "name": "ostrilo-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "compile": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "doctor": "react-doctor . --yes --json",
    "slop": "aislop scan",
    "slop:changes": "aislop scan --changes",
    "slop:ci": "aislop ci --human",
    "quality": "node scripts/check-quality.mjs",
    "verify": "pnpm run format:check && pnpm run compile && pnpm run build && pnpm run test && pnpm run quality",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aislop": "0.18.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "react-doctor": "0.9.17",
    "typescript": "6.0.3"
  }
}
